    <style>
      :root {
        --bg-color: #000000;
        --sidebar-bg: #000000;
        --main-bg: #000000;
        --text-color: #ffffff;
        --text-muted: #a1a1a6;
        --accent-color: #2997ff;
        --accent-hover: #51a8ff;
        --border-color: #262629;
        --code-bg: #111112;
        --warning-bg: #1c1c1e;
        --warning-border: #ffd60a;
        --warning-text: #ffd60a
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        background-color: var(--bg-color);
        color: var(--text-color);
        line-height: 1.5;
        font-weight: 400;
        letter-spacing: -.022em;
        display: flex
      }

      aside {
        position: fixed;
        top: 0;
        left: 0;
        width: 280px;
        height: 100vh;
        background-color: var(--sidebar-bg);
        padding: 4rem 2rem 2rem 3rem;
        overflow-y: auto;
        z-index: 100
      }

      aside ul {
        list-style: none;
        padding-left: 0;
        margin-top: .5rem
      }

      aside li {
        margin-bottom: .25rem
      }

      aside a {
        color: var(--text-muted);
        text-decoration: none;
        font-size: .9rem;
        font-weight: 400;
        display: block;
        padding: .5rem .75rem;
        border-radius: 8px;
        margin-left: -.75rem;
        transition: color .15s ease, background-color .15s ease
      }

      aside a:hover {
        color: #fff;
        background-color: #1c1c1e
      }

      main {
        margin-left: 280px;
        max-width: 920px;
        width: calc(100% - 280px);
        padding: 4rem 5rem 4rem 3rem;
        border-left: 1px solid var(--border-color);
        min-height: 100vh
      }

      .doc-header {
        margin-bottom: 4rem;
        padding-bottom: 2rem;
        border-bottom: 1px solid var(--border-color)
      }

      .doc-header h1 {
        font-size: 2.5rem;
        font-weight: 700;
        letter-spacing: -.04em;
        margin-bottom: .5rem;
        color: #fff
      }

      .doc-header .subtitle {
        font-size: 1.1rem;
        color: var(--text-muted);
        font-weight: 400;
        letter-spacing: -.015em
      }

      .doc-header .subtitle a {
        color: var(--accent-color);
        text-decoration: none
      }

      .doc-header .subtitle a:hover {
        text-decoration: underline
      }

      section {
        margin-bottom: 4.5rem;
        scroll-margin-top: 4rem
      }

      h2 {
        font-size: 1.75rem;
        font-weight: 600;
        letter-spacing: -.021em;
        border-bottom: 1px solid var(--border-color);
        padding-bottom: .75rem;
        margin-bottom: 2rem;
        margin-top: 1rem;
        color: #fff
      }

      h3 {
        font-size: 1.25rem;
        font-weight: 600;
        letter-spacing: -.011em;
        margin-top: 3rem;
        margin-bottom: 1rem;
        color: #fff
      }

      p {
        margin-bottom: 1.25rem;
        color: #e8e8ed;
        font-size: 1rem
      }

      img.zoomable {
        max-width: 100%;
        height: auto;
        display: block;
        margin: 1.75rem 0;
        border-radius: 8px;
        border: 1px solid var(--border-color);
        background-color: #000;
        cursor: zoom-in;
        transition: transform .2s ease, border-color .2s ease
      }

      img.zoomable:hover {
        border-color: var(--accent-color);
        transform: scale(1.005)
      }

      .lightbox {
        display: none;
        position: fixed;
        z-index: 1000;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, .92);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        justify-content: center;
        align-items: center;
        cursor: zoom-out;
        opacity: 0;
        transition: opacity .25s ease
      }

      .lightbox.active {
        display: flex;
        opacity: 1
      }

      .lightbox-content {
        max-width: 90%;
        max-height: 85%;
        object-fit: contain;
        border-radius: 6px;
        border: 1px solid var(--border-color);
        transform: scale(.95);
        transition: transform .25s ease
      }

      .lightbox.active .lightbox-content {
        transform: scale(1)
      }

      .lightbox-close {
        position: absolute;
        top: 1.5rem;
        right: 2rem;
        color: var(--text-muted);
        font-size: 2rem;
        font-weight: 300;
        cursor: pointer;
        user-select: none;
        transition: color .15s ease
      }

      .lightbox-close:hover {
        color: #fff
      }

      pre {
        background-color: var(--code-bg) !important;
        margin: 1.5rem 0;
        border: 1px solid var(--border-color);
        border-radius: 10px;
        overflow: hidden
      }

      pre code {
        padding: 1.5rem !important;
        font-family: "SF Mono", SFMono-Regular, ui-monospace, Menlo, Consolas, monospace !important;
        font-size: .875rem !important;
        line-height: 1.65 !important;
        background: 0 0 !important
      }

      code:not(pre code) {
        font-family: "SF Mono", SFMono-Regular, ui-monospace, Menlo, Consolas, monospace;
        background-color: #1c1c1e;
        padding: .2rem .4rem;
        border-radius: 5px;
        font-size: .875rem;
        color: #fff;
        border: 1px solid var(--border-color)
      }

      table {
        width: 100%;
        border-collapse: collapse;
        margin: 2.5rem 0;
        font-size: .9rem;
        background: 0 0;
        border: 1px solid var(--border-color);
        border-radius: 10px;
        overflow: hidden
      }

      td,
      th {
        padding: 1rem 1.25rem;
        border-bottom: 1px solid var(--border-color);
        text-align: left
      }

      th {
        background-color: #111112;
        color: #fff;
        font-weight: 500
      }

      td {
        color: #e8e8ed
      }

      tr:last-child td {
        border-bottom: none
      }

      tr:nth-child(even) {
        background-color: #0a0a0a
      }

      .warning-callout {
        background-color: var(--warning-bg);
        border: 1px solid #48484a;
        border-left: 4px solid var(--warning-border);
        padding: 1.25rem 1.5rem;
        margin: 1.75rem 0;
        border-radius: 10px;
        font-size: .95rem
      }

      .warning-callout p {
        margin: 0;
        color: #fff
      }

      .warning-callout strong {
        color: var(--warning-text);
        font-weight: 600
      }

      ol,
      ul.doc-list {
        margin-left: 1.5rem;
        margin-bottom: 1.5rem;
        font-size: 1rem;
        color: #e8e8ed
      }

      ol li,
      ul.doc-list li {
        margin-bottom: .5rem;
        padding-left: .25rem
      }

      main a {
        color: var(--accent-color);
        text-decoration: none;
        transition: color .15s ease
      }

      main a:hover {
        color: var(--accent-hover)
      }

      @media (max-width:960px) {
        body {
          flex-direction: column
        }

        aside {
          position: static;
          width: 100%;
          height: auto;
          padding: 3rem 2rem 1rem 2rem
        }

        main {
          margin-left: 0;
          width: 100%;
          padding: 2rem;
          border-left: none;
          border-top: 1px solid var(--border-color)
        }
      }
    </style>
