    <div class=lightbox aria-label="{{lightbox_aria_label}}" id=imageViewer role=dialog><span class=lightbox-close id=closeViewer>×</span><img alt="" class=lightbox-content src="" id=viewerImg></div>
    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const t = document.getElementById("imageViewer"),
          c = document.getElementById("viewerImg"),
          e = document.getElementById("closeViewer"),
          d = document.querySelectorAll("img.zoomable");
        d.forEach(e => {
          e.addEventListener("click", () => {
            c.src = e.src, c.alt = e.alt, t.classList.add("active"), document.body.style.overflow = "hidden"
          })
        });
        const n = () => {
          t.classList.remove("active"), document.body.style.overflow = "", setTimeout(() => {
            c.src = ""
          }, 250)
        };
        t.addEventListener("click", e => {
          e.target !== c && n()
        }), e.addEventListener("click", n), document.addEventListener("keydown", e => {
          "Escape" === e.key && t.classList.contains("active") && n()
        })
      })
    </script>
    <script>
      (function () {
        function track(name, params) {
          if (typeof window.gtag === "function") {
            window.gtag("event", name, Object.assign({
              lang: document.documentElement.lang || "unknown"
            }, params || {}))
          }
        }

        document.addEventListener("DOMContentLoaded", function () {
          document.querySelectorAll("aside a[href^='#']").forEach(function (a) {
            a.addEventListener("click", function () {
              track("nav_click", {
                section: (a.getAttribute("href") || "").slice(1),
                link_text: (a.textContent || "").trim()
              })
            })
          });
          document.querySelectorAll("main a[href]").forEach(function (a) {
            a.addEventListener("click", function () {
              var href = a.getAttribute("href") || "";
              var linkText = (a.textContent || "").trim().slice(0, 80);
              if (href.indexOf("mailto:") === 0) {
                track("email_click", { link_text: linkText });
                return
              }
              if (/^https?:\/\//i.test(href)) {
                var domain = "";
                try { domain = new URL(href, location.href).hostname } catch (err) {}
                track("outbound_click", {
                  link_url: href,
                  link_domain: domain,
                  link_text: linkText
                });
                if (domain === "fab.com" || domain === "www.fab.com") {
                  track("fab_marketplace_click", { link_url: href })
                }
                if (domain === "github.com") {
                  track("github_link_click", { link_url: href })
                }
              }
            })
          });
          document.querySelectorAll("img.zoomable").forEach(function (img) {
